# HOME
msgid "home.title"
msgstr "Dulno"
msgid "home.headline"
msgstr "Home"
msgid "home.slogan"
msgstr "Plan, Execute, Save"
msgid "home.description.1"
msgstr "We offer a code-free automation environment for everyone."
